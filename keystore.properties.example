# Copie ce fichier en "keystore.properties" (jamais committé, voir .gitignore) et renseigne
# le vrai chemin + mots de passe. Les vraies valeurs vivent dans ~/.android-keys/, hors du dépôt.
storeFile=/home/gauthier/.android-keys/affut-release.jks
storePassword=CHANGE_ME
keyAlias=affut-release
